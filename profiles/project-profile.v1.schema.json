{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileVersion": {
      "const": "archon.project-profile.v1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "remote",
        "defaultBranch",
        "stack",
        "packageManager"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          }
        },
        "required": [
          "id",
          "argv",
          "timeoutSeconds"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "forbiddenPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowedPaths",
        "forbiddenPaths"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      },
      "required": [
        "paths",
        "maxBytes"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "maxRounds"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "draftOnly": {
          "const": true
        },
        "autoMerge": {
          "const": false
        },
        "autoDeploy": {
          "const": false
        }
      },
      "required": [
        "draftOnly",
        "autoMerge",
        "autoDeploy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profileVersion",
    "projectId",
    "repository",
    "verification",
    "scope",
    "knowledge",
    "recovery",
    "delivery"
  ],
  "additionalProperties": false
}
