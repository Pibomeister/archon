{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileVersion": {
      "const": "archon.project-profile.v1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "remote",
        "defaultBranch",
        "stack",
        "packageManager"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          }
        },
        "required": [
          "id",
          "argv",
          "timeoutSeconds"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "forbiddenPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowedPaths",
        "forbiddenPaths"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Sibling directory under PROJECT_ROOT that holds the KB. Omit when the project itself is the knowledge root."
        },
        "required": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      },
      "required": [
        "paths",
        "maxBytes"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "maxRounds"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "draftOnly": {
          "const": true
        },
        "autoMerge": {
          "const": false
        },
        "autoDeploy": {
          "const": false
        }
      },
      "required": [
        "draftOnly",
        "autoMerge",
        "autoDeploy"
      ],
      "additionalProperties": false
    },
    "guidance": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "conventions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "playbook": {
          "type": "string",
          "minLength": 1
        },
        "envelopePath": {
          "type": "string",
          "minLength": 1
        },
        "debug": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "cli": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "cli", "note"],
            "additionalProperties": false
          }
        }
      },
      "required": ["root"],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "gitnexusRepo": { "type": "string", "minLength": 1 },
        "smoke": {
          "type": "object",
          "properties": {
            "apiPortBase": { "type": "integer", "minimum": 1 },
            "webPortBase": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "generatedApiSync": { "type": "boolean" },
        "browserUat": { "type": "boolean" },
        "impactUnavailable": { "enum": ["allow", "route-full"] },
        "layout": { "enum": ["siblings", "single"] },
        "defaultRepo": { "type": "string", "minLength": 1 },
        "allowedRepos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "webRepo": { "type": "string", "minLength": 1 },
        "requiredCheckouts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "fail": { "type": "boolean" }
            },
            "required": ["id", "fail"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "profileVersion",
    "projectId",
    "repository",
    "verification",
    "scope",
    "knowledge",
    "recovery",
    "delivery"
  ],
  "additionalProperties": false
}
