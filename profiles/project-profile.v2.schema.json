{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileVersion": {
      "const": "archon.project-profile.v2"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "stack": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "remote",
        "defaultBranch",
        "stack"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          }
        },
        "required": [
          "id",
          "argv",
          "timeoutSeconds"
        ],
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "forbiddenPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allowedPaths",
        "forbiddenPaths"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "Sibling directory under PROJECT_ROOT that holds the KB. Omit when the project itself is the knowledge root."
        },
        "required": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      },
      "required": [
        "paths",
        "maxBytes"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "maxRounds"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "draftOnly": {
          "const": true
        },
        "autoMerge": {
          "const": false
        },
        "autoDeploy": {
          "const": false
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "draftOnly",
        "autoMerge",
        "autoDeploy",
        "baseBranch"
      ],
      "additionalProperties": false
    },
    "noChangeClosure": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "verifierIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "enabled",
        "verifierIds"
      ],
      "additionalProperties": false
    },
    "sourceRecipe": {
      "enum": [
        "archon-engine-bun.v1",
        "goodword-workflows-python.v1"
      ]
    },
    "guidance": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "conventions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "playbook": {
          "type": "string",
          "minLength": 1
        },
        "envelopePath": {
          "type": "string",
          "minLength": 1
        },
        "debug": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "cli": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "cli", "note"],
            "additionalProperties": false
          }
        }
      },
      "required": ["root"],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "gitnexusRepo": { "type": "string", "minLength": 1 },
        "smoke": {
          "type": "object",
          "properties": {
            "apiPortBase": { "type": "integer", "minimum": 1 },
            "webPortBase": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "generatedApiSync": { "type": "boolean" },
        "browserUat": { "type": "boolean" },
        "impactUnavailable": { "enum": ["allow", "route-full"] },
        "layout": { "enum": ["siblings", "single"] },
        "defaultRepo": { "type": "string", "minLength": 1 },
        "allowedRepos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "webRepo": { "type": "string", "minLength": 1 },
        "requiredCheckouts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "fail": { "type": "boolean" }
            },
            "required": ["id", "fail"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "description": "Risk-tier inputs merged over setup/risk-policy.json. Floors here can only add; setup/risk_policy.py refuses anything that weakens a default floor.",
      "properties": {
        "protectedAreas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "floor": {"enum": ["green", "yellow", "red"]},
              "reason": {"type": "string", "minLength": 1}
            },
            "required": ["paths", "floor", "reason"],
            "additionalProperties": false
          }
        },
        "codeowners": {
          "type": "object",
          "properties": {
            "ownerFloors": {"type": "object", "additionalProperties": {"enum": ["green", "yellow", "red"]}},
            "defaultOwnedFloor": {"enum": ["green", "yellow", "red"]}
          },
          "additionalProperties": false
        },
        "sensitiveDomains": {
          "type": "object",
          "properties": {
            "extraPaths": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "publicContract": {
          "type": "object",
          "properties": {"paths": {"type": "array", "items": {"type": "string", "minLength": 1}}},
          "additionalProperties": false
        },
        "sideEffects": {
          "type": "object",
          "properties": {"paths": {"type": "array", "items": {"type": "string", "minLength": 1}}},
          "additionalProperties": false
        },
        "thresholds": {
          "type": "object",
          "properties": {"yellow": {"type": "integer", "minimum": 0}, "red": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        },
        "points": {
          "type": "object",
          "description": "Per-signal scoring deltas merged over setup/risk-policy.json points; only the keys setup/risk_policy.py's _REQUIRED_POINTS recognizes are accepted.",
          "properties": {
            "taskClass": {
              "type": "object",
              "properties": {
                "docs": {"type": "integer", "minimum": 0},
                "chore": {"type": "integer", "minimum": 0},
                "bugfix": {"type": "integer", "minimum": 0},
                "feature": {"type": "integer", "minimum": 0},
                "refactor": {"type": "integer", "minimum": 0},
                "migration": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "triage": {
              "type": "object",
              "properties": {
                "S": {"type": "integer", "minimum": 0},
                "M": {"type": "integer", "minimum": 0},
                "L": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "filesOverMax": {"type": "integer", "minimum": 0},
            "perExtraFile": {"type": "integer", "minimum": 0},
            "testFilesOverMax": {"type": "integer", "minimum": 0},
            "callersOverMax": {"type": "integer", "minimum": 0},
            "chainLinksOverMax": {"type": "integer", "minimum": 0},
            "impactUnavailable": {"type": "integer", "minimum": 0},
            "impactMissing": {"type": "integer", "minimum": 0},
            "unknownCoverage": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "profileVersion",
    "projectId",
    "repository",
    "verification",
    "scope",
    "knowledge",
    "recovery",
    "delivery",
    "sourceRecipe"
  ],
  "additionalProperties": false
}
